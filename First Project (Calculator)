#The division operation
def divOp():
    validDivOne = False
    validDivTwo = False
    while not validDivOne:
        try:
            divNumOne = float(input("What's the first number? "))
            validDivOne = True
        except ValueError:
            print("Give an appropriate first number!")
    while not validDivTwo:
        try:
            divNumTwo = float(input("What's the second number? "))
            validDivTwo = True
        except ValueError:
            print("Give an appropriate second number!")
    division = divNumOne / divNumTwo
    roundDivision = round(division,2)
    print("= " + str(roundDivision))

#The squaring operation
def squareOp():
    validSquareOne = False
    validSquareTwo = False
    while not validSquareOne:
        try:
            squareNumOne = float(input("What's the number? "))
            validSquareOne = True
        except ValueError:
            print("Give an appropriate number!")
    while not validSquareTwo:
        try:
            squareNumTwo = float(input("What's the power? "))
            validSquareTwo = True
        except ValueError:
            print("Give an appropriate power!")
    squaring = squareNumOne ** squareNumTwo
    print("= " + str(squaring))

