#The addition operation
def addOp():
    validAddOne = False
    validAddTwo = False
    while not validAddOne:
        try:
            addNumOne = float(input("What's the first number? "))
            validAddOne = True
        except ValueError:
            print("Give an appropriate first number!")
    while not validAddTwo:
        try:
            addNumTwo = float(input("What's the second number? "))
            validAddTwo = True
        except ValueError:
            print("Give an appropriate second number!")
    addition = addNumOne + addNumTwo
    print("= " + str(addition))

